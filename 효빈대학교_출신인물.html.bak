<!DOCTYPE html>
<html lang="ko">
<head>
    <link rel="icon" href="이미지/효빈위키아이콘.webp">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>효빈대학교/출신 인물 - 효빈위키</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;700;900&display=swap');
        
        :root { 
            /* 문서 테마 컬러: 효빈대 파랑 */
            --wiki-main: #3344aa; 
            --wiki-sub: #2a3a8c;
            
            --wiki-border: #ccc; 
            --wiki-bg: #ffffff; 
            --wiki-text: #373a3c; 
            --wiki-gray-bg: #F9F9FA; 
            --wiki-link: #0022AA;
            --wiki-table-header: #3344aa;
            --wiki-table-header-text: #ffffff;
        }

        body { font-family: 'Noto Sans KR', sans-serif; background-color: var(--wiki-bg); color: var(--wiki-text); line-height: 1.6; word-break: keep-all; margin: 0; }
        .wiki-container { max-width: 1300px; margin: 0 auto; padding: 20px 40px; border-left: 1px solid var(--wiki-border); border-right: 1px solid var(--wiki-border); min-height: 100vh; background-color: var(--wiki-bg); }

        /* 타이틀 스타일 */
        .txt-lvl-1 { font-size: var(--font-h1) !important; font-weight: 900 !important; color: #000000; line-height: 1.1; letter-spacing: -1.5px; margin-bottom: 0; } 
        .title-area { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid #ccc; margin-bottom: 20px; padding-bottom: 10px; }

        /* 문단 제목 스타일 */
        h2 { font-size: 1.8rem !important; font-weight: 700; border-bottom: 1px solid var(--wiki-border); padding-bottom: 5px; margin-top: 2.5rem; display: flex; align-items: center; gap: 10px; color: var(--wiki-text); clear: both; }
        h2::before { content: ""; display: inline-block; width: 5px; height: 1.8rem; background: var(--wiki-main); }
        h3 { font-size: 1.4rem !important; font-weight: 700; margin-top: 1.8rem; border-left: 4px solid var(--wiki-main); padding-left: 12px; color: var(--wiki-text); }
        h4 { font-size: 1.15rem !important; font-weight: 700; margin-top: 1.5rem; margin-bottom: 0.8rem; color: #3344aa; border-bottom: 1px dashed #ccc; padding-bottom: 4px; }

        /* 위키 버튼 */
        .wiki-btn { 
            border: 1px solid #ccc; background: white; padding: 4px 12px; border-radius: 4px; font-size: var(--font-small); font-weight: bold; color: #555; 
            cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 4px; text-decoration: none !important; 
        }
        .wiki-btn:hover { background: #f0f0f0; color: #000; border-color: #999; }

        /* 링크 스타일 */
        .wiki-link { color: var(--wiki-link); font-weight: bold; cursor: pointer; text-decoration: none; }
        .wiki-link:hover { text-decoration: underline; }
        .category-box { background: #f9f9f9; border: 1px solid var(--wiki-border); padding: 8px 12px; font-size: 0.8rem; margin: 15px 0; border-radius: 4px; }
        
        /* 테이블 스타일 */
        .wiki-table { border-collapse: collapse; width: 100%; margin: 10px 0; border: 1px solid #ccc; }
        .wiki-table th { background-color: var(--wiki-main); color: white; padding: 8px; border: 1px solid #ccc; text-align: center; font-weight: bold; }
        .wiki-table td { padding: 8px; border: 1px solid #ccc; background: white; }
        .wiki-table-center { text-align: center; }
        .wiki-table-right { text-align: right; }

        /* 목차 */
        .toc { display: inline-block; min-width: 300px; border: 1px solid var(--wiki-border); background: var(--wiki-gray-bg); padding: 15px; border-radius: 4px; margin-bottom: 20px; }
        .toc-title { text-align: center; font-weight: bold; border-bottom: 1px solid var(--wiki-border); margin-bottom: 10px; padding-bottom: 5px; }
        .toc ul { list-style: none; padding: 0; margin: 0; font-size: 0.9rem; }
        .toc ul li { margin-bottom: 4px; }
        .toc ul ul { margin-top: 4px; margin-left: 20px; }
        
        /* 기타 요소 */
        blockquote { border-left: 4px solid var(--wiki-main); padding-left: 15px; margin: 15px 0; color: #555; background-color: #f8f9fa; padding: 10px; font-style: italic; }
        .footnote { font-size: 0.8em; vertical-align: super; color: var(--wiki-link); text-decoration: none; cursor: pointer; }
        
        .img-container { text-align: center; margin: 15px 0; }
        .img-container img { max-width: 100%; border: 1px solid #ccc; border-radius: 4px; padding: 4px; background: white; }
        .img-caption { font-size: 0.85rem; color: #666; margin-top: 5px; }
        
        .nav-box { border: 2px solid var(--wiki-main); margin-top: 40px; font-size: 0.85rem; border-radius: 4px; overflow: hidden; }
        .nav-box-header { background-color: var(--wiki-main); color: white; padding: 8px; font-weight: bold; text-align: center; }
        .nav-box-content { padding: 10px; text-align: center; background: white; line-height: 2; }
        .wiki-footer { margin-top: 40px; border-top: 1px solid #ccc; padding: 20px; text-align: left; font-size: 0.8rem; color: #555; background-color: #f9f9f9; line-height: 1.5; }

        .profile-box { display: flex; align-items: flex-start; gap: 20px; background: white; border: 1px solid #ddd; padding: 15px; border-radius: 8px; margin-bottom: 20px; flex-wrap: wrap; }
        .profile-img { flex-shrink: 0; width: 120px; height: 160px; background-color: #eee; border: 1px solid #ccc; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 4px; }
        .profile-img img { width: 100%; height: 100%; object-fit: cover; }
        .profile-info { flex-grow: 1; min-width: 300px; width: calc(100% - 140px); }
        .profile-name { font-size: 1.5rem; font-weight: bold; color: var(--wiki-main); margin-bottom: 5px; border-bottom: 1px solid #eee; padding-bottom: 5px; }
        .profile-dept { font-size: 0.9rem; color: #666; font-weight: bold; margin-bottom: 10px; }
        
        .lore-box { background-color: #f0f4ff; border-left: 4px solid var(--wiki-main); padding: 12px; margin-top: 12px; font-size: 0.9rem; border-radius: 0 4px 4px 0; }
        .lore-title { font-weight: bold; color: var(--wiki-main); margin-bottom: 5px; display: block; font-size: 1.05rem; }
        .strike { text-decoration: line-through; color: #888; }
/* 로고 박스 스타일 추가 */
        .nav-logo-box {
            width: 30px; height: 30px; background: white; color: var(--wiki-main);
            border-radius: 4px; font-weight: 900; display: flex; align-items: center;
            justify-content: center; font-size: 1.2rem;
        }   
 
            body { font-family: 'Noto Sans KR', sans-serif; background-color: var(--wiki-bg); color: var(--wiki-text); line-height: 1.6; word-break: keep-all; margin: 0; }
        .wiki-container { max-width: 1300px; margin: 0 auto; padding: 20px 40px; border-left: 1px solid var(--wiki-border); border-right: 1px solid var(--wiki-border); min-height: 100vh; background-color: var(--wiki-bg); }

        /* 타이틀 스타일 */
        .txt-lvl-1 { font-size: var(--font-h1) !important; font-weight: 900 !important; color: #000000; line-height: 1.1; letter-spacing: -1.5px; margin-bottom: 0; } 
        .title-area { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid #ccc; margin-bottom: 20px; padding-bottom: 10px; }

        /* 문단 제목 스타일 */
        h2 { font-size: 1.8rem !important; font-weight: 700; border-bottom: 1px solid var(--wiki-border); padding-bottom: 5px; margin-top: 2.5rem; display: flex; align-items: center; gap: 10px; color: var(--wiki-text); clear: both; }
        h2::before { content: ""; display: inline-block; width: 5px; height: 1.8rem; background: var(--wiki-main); }
        h3 { font-size: 1.4rem !important; font-weight: 700; margin-top: 1.8rem; border-left: 4px solid var(--wiki-main); padding-left: 12px; color: var(--wiki-text); }
        h4 { font-size: 1.15rem !important; font-weight: 700; margin-top: 1.2rem; margin-bottom: 0.5rem; color: #444; border-left: 3px solid #ccc; padding-left: 8px; }

        /* 위키 버튼 */
        .wiki-btn { 
            border: 1px solid #ccc; background: white; padding: 4px 12px; border-radius: 4px; font-size: var(--font-small); font-weight: bold; color: #555; 
            cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 4px; text-decoration: none !important; 
        }
        .wiki-btn:hover { background: #f0f0f0; color: #000; border-color: #999; }

        /* 링크 스타일 */
        .wiki-link { color: var(--wiki-link); font-weight: bold; cursor: pointer; text-decoration: none; }
        .wiki-link:hover { text-decoration: underline; }
        .category-box { background: #f9f9f9; border: 1px solid var(--wiki-border); padding: 8px 12px; font-size: 0.8rem; margin: 15px 0; border-radius: 4px; }
        
        /* 인포박스 스타일 */
        .infobox { border: 2px solid var(--wiki-main); background-color: #fff; width: 100%; max-width: 450px; font-size: 0.9rem; margin-bottom: 20px; float: right; margin-left: 20px; border-radius: 4px; overflow: hidden; }
        .infobox-header { background-color: var(--wiki-main); color: white; padding: 10px; text-align: center; font-size: 1.4rem !important; font-weight: bold; }
        .infobox table { border: none; width: 100%; border-collapse: collapse; }
        .infobox th { background-color: #f0f4f8; color: var(--wiki-main); width: 100px; padding: 6px 10px; border: 1px solid var(--wiki-border); text-align: center; font-weight: bold; vertical-align: middle; }
        .infobox td { padding: 6px 10px; border: 1px solid var(--wiki-border); vertical-align: middle; }
        
        /* 테이블 스타일 */
    .wiki-table { 
        border-collapse: collapse; 
        width: 100%; 
        margin: 10px 0; 
        border: 1px solid #ccc; 
        table-layout: fixed; /* 핵심: 셀 너비를 내용이 아닌 테이블 너비에 맞춰 고정 */
    }
    .wiki-table th { 
        background-color: #3344aa; /* var(--wiki-main) */
        color: white; 
        padding: 8px; 
        border: 1px solid #ccc; 
        text-align: center; 
        font-weight: bold; 
    }
    .wiki-table td { 
        padding: 8px; 
        border: 1px solid #ccc; 
        background: white; 
        width: 25%; /* 4열이므로 각각 25%로 강제 지정 */
        word-break: keep-all; /* 단어 단위로 줄바꿈하여 레이아웃 유지 */
        vertical-align: middle;
    }
    .wiki-table-center { text-align: center; }
        /* 목차 */
        .toc { display: inline-block; min-width: 300px; border: 1px solid var(--wiki-border); background: var(--wiki-gray-bg); padding: 15px; border-radius: 4px; margin-bottom: 20px; }
        .toc-title { text-align: center; font-weight: bold; border-bottom: 1px solid var(--wiki-border); margin-bottom: 10px; padding-bottom: 5px; }
        .toc ul { list-style: none; padding: 0; margin: 0; font-size: 0.9rem; }
        .toc ul li { margin-bottom: 4px; }
        .toc ul ul { margin-top: 4px; margin-left: 20px; }
        
        table { border-collapse: collapse !important; width: 100% !important; margin: 15px 0; border: 1px solid var(--wiki-border) !important; table-layout: auto !important; font-size: 0.85rem; }
        th, td { border: 1px solid var(--wiki-border) !important; padding: 8px 12px; text-align: center; vertical-align: middle; }
        th { background-color: var(--wiki-table-header); color: var(--wiki-table-header-text); font-weight: bold; }

        /* 기타 요소 */
        blockquote { border-left: 4px solid var(--wiki-main); padding-left: 15px; margin: 15px 0; color: #555; background-color: #f8f9fa; padding: 10px; font-style: italic; }
        del { color: #ccc; text-decoration: line-through; }
        .wiki-gray { color: #888; font-size: 0.9em; }
        
        /* 폴딩(접기/펼치기) 구현 */
        details { border: 1px solid #aaa; border-radius: 4px; padding: 0; margin-bottom: 10px; background: white; }
        summary { font-weight: bold; padding: 0.5em; cursor: pointer; background-color: #eee; list-style: none; display: flex; justify-content: center; align-items: center; }
        summary:after { content: " [ 펼치기 · 접기 ]"; font-size: 0.8em; margin-left: 5px; color: #555; }
        details[open] { padding: 0; }
        details[open] summary { border-bottom: 1px solid #aaa; }

        /* 하단 네비게이션 */
        .nav-box { border: 2px solid var(--wiki-main); margin-top: 40px; font-size: 0.85rem; border-radius: 4px; overflow: hidden; }
        .nav-box-header { background-color: var(--wiki-main); color: white; padding: 8px; font-weight: bold; text-align: center; }
        .nav-box-content { padding: 10px; text-align: center; background: white; line-height: 2; }
        

        /* 푸터 */
        .wiki-footer { margin-top: 40px; border-top: 1px solid #ccc; padding: 20px; text-align: left; font-size: 0.8rem; color: #555; background-color: #f9f9f9; line-height: 1.5; }

        #wiki-msg-box { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,0.8); color: white; padding: 10px 24px; border-radius: 50px; font-size: 14px; z-index: 10000; display: none; }
        .anchor-offset { scroll-margin-top: 70px; }
        
        /* 상단 그라데이션 박스 */
        .gradient-box {
            background-image: linear-gradient(to right, #3344aa, #2a3a8c, #2a3a8c, #3344aa);
            color: white; padding: 20px; text-align: center; border-radius: 5px; margin-bottom: 0px;
        }

        /* 팩트폭격 접기 스타일 */
        .fact-bomb-details { margin-top: 10px; border-color: #ffcccc; }
        .fact-bomb-details summary { background-color: #ffeeee; color: #d32f2f; }
        .fact-bomb-content { background-color: #fff5f5; padding: 10px; }
                /* 각주 스타일 */
        .wiki-fn { font-size: 0.8em; vertical-align: super; color: var(--wiki-link); text-decoration: none; font-weight: bold; cursor: help; margin-left: 1px; }
        .wiki-fn:hover { text-decoration: underline; }
        .wiki-fn-content-box { border-top: 1px solid #ccc; margin-top: 40px; padding-top: 10px; font-size: 0.9rem; }
        .wiki-fn-item { margin-bottom: 6px; }
        .wiki-fn-back { color: var(--wiki-link); text-decoration: none; margin-right: 5px; font-weight: bold; }
        
        /* 각주 툴팁 (호버보드) */
        #wiki-fn-tooltip {
            position: fixed;
            display: none;
            background: #fff;
            border: 1px solid var(--wiki-main);
            padding: 8px 12px;
            font-size: 0.85rem;
            max-width: 350px;
            z-index: 100000;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            border-radius: 6px;
            pointer-events: none;
            color: #333;
            line-height: 1.5;
        }

        /* 둘러보기 틀 스타일 */
        .nav-template { width: 100%; border: 2px solid var(--wiki-main); border-radius: 4px; overflow: hidden; margin-bottom: 20px; clear: both; font-size: 0.9rem; }
        .nav-template-header { background-color: var(--wiki-main); color: white; padding: 8px 12px; font-weight: bold; display: flex; justify-content: space-between; align-items: center; }
        .nav-template-content { background-color: #fff; }
        .nav-template-table { width: 100%; border-collapse: collapse; }
        .nav-template-table th { background-color: #e6f2ee; color: #333; border: 1px solid #ddd; padding: 6px 10px; text-align: center; font-weight: bold; width: 100px; }
        .nav-template-table td { border: 1px solid #ddd; padding: 6px 10px; }
        .nav-template-sub-th { background-color: #f5f9fa; font-weight: bold; text-align: center; width: 40px; color: #555; }
        .nav-group { display: flex; flex-wrap: wrap; gap: 8px; }
        .nav-item { color: #333; text-decoration: none; }
        .nav-item:hover { text-decoration: underline; color: var(--wiki-link); }
        .nav-current { font-weight: 900; color: var(--wiki-main); background-color: #e6f2ee; padding: 2px 6px; border-radius: 4px; }
    /* =========================================
   효빈위키 둘러보기 틀(Navbox) 전용 스타일
========================================= */

/* 둘러보기 틀 외부 컨테이너 */
.nw-box { 
    border: 1px solid #aaa; 
    margin-bottom: 20px; 
    font-size: 13px; 
    font-family: 'Noto Sans KR', sans-serif; 
    background: #fff; 
    clear: both; 
}

/* 둘러보기 틀 상단 메인 제목 */
.nw-title { 
    background-color: #003a70; 
    color: #fff; 
    text-align: center; 
    padding: 6px 10px; 
    font-weight: bold; 
    border-bottom: 1px solid #aaa; 
}

/* HTML5 <details> 기본 화살표 숨김 및 커스텀 처리 */
details.nw-details > summary { 
    list-style: none; 
    display: block; 
}
details.nw-details > summary::-webkit-details-marker { 
    display: none; /* Safari 지원 */
}
details.nw-details > summary::after { 
    content: none !important; 
}

/* 펼치기/접기 버튼 영역 스타일 */
.nw-fold { 
    text-align: center; 
    background-color: #fff; 
    border-bottom: 1px solid #aaa; 
    padding: 3px; 
    font-size: 11px; 
    font-weight: bold; 
    color: #555; 
    cursor: pointer; 
    user-select: none; 
}

/* 기본 테이블 (좌측 th, 우측 td 형태) */
.nw-table { 
    width: 100%; 
    border-collapse: collapse; 
}
.nw-table th { 
    background-color: #003a70; 
    color: #fff; 
    border: 1px solid #aaa; 
    padding: 8px 10px; 
    font-weight: normal; 
    text-align: center; 
    vertical-align: middle; 
    white-space: nowrap; 
    width: 15%; 
}
.nw-table td { 
    background-color: #fff; 
    color: #333; 
    border: 1px solid #aaa; 
    padding: 8px 12px; 
    line-height: 1.6; 
    word-break: keep-all; 
    text-align: left; 
}

/* 격자형 테이블 (상단 th, 하단 td 형태 - 거점국립대 로고 틀 등) */
.nw-grid-table { 
    width: 100%; 
    border-collapse: collapse; 
}
.nw-grid-table th { 
    background-color: #003a70; 
    color: #fff; 
    border: 1px solid #aaa; 
    padding: 8px; 
    font-weight: bold; 
    text-align: center; 
    width: 20%; 
}
.nw-grid-table td { 
    background-color: #fff; 
    border: 1px solid #aaa; 
    padding: 15px 5px; 
    text-align: center; 
    vertical-align: top; 
    width: 20%; 
}

/* 링크 및 하이라이트 텍스트 스타일 */
.nw-link { 
    color: #0055AA; 
    text-decoration: none; 
    display: inline-flex; 
    align-items: center; 
    white-space: nowrap; 
    cursor: pointer; 
    margin-right: 2px; 
}
.nw-link:hover { 
    text-decoration: underline; 
}
.nw-bold { 
    font-weight: bold; 
    color: #000; 
}
.nw-highlight { 
    font-weight: 900; 
    color: #540027; /* 전북대 메인 컬러 등 현재 문서 대상 하이라이트 */
}
.nw-hyobin { 
    font-weight: bold; 
    color: #0055AA; /* 효빈광역시 소속 대학 전용 링크 컬러 */
}

/* 아이콘 및 구분자 기호 */
.nw-dot { 
    margin: 0 4px; 
    color: #888; 
    font-weight: bold; 
}
.nw-icon { 
    display: inline-block; 
    width: 14px; 
    height: 14px; 
    border-radius: 50%; 
    background-color: #eee; 
    border: 1px solid #ccc; 
    margin-right: 4px; 
    vertical-align: text-bottom; 
}
.nw-logo-placeholder { 
    width: 60px; 
    height: 60px; 
    border-radius: 50%; 
    border: 1px solid #ddd; 
    background-color: #f9f9f9; 
    display: flex; 
    justify-content: center; 
    align-items: center; 
    margin: 0 auto 5px; 
    font-size: 11px; 
    color: #aaa; 
    font-weight: bold; 
}
    
</style>
<script src="ad_logic.js"></script>

    <!-- 효빈위키 폰트 CSS -->
    <link rel="stylesheet" href="wiki_font_standard.css">
</head>        

<body>

    <div id="wiki-msg-box"></div>

    <!-- 상단 네비게이션 -->
    <nav class="font-sans bg-[#7777AA] text-white p-3 flex justify-between items-center shadow-md sticky top-0 z-50">
    <div class="flex items-center gap-2">
        <div class="nav-logo-box">H</div>
        <a href="index.html" class="font-bold text-xl cursor-pointer no-underline text-white">HyobinWiki</a>
        <div class="hidden md:flex gap-3 text-sm opacity-90 ml-4">
            <a href="index.html" class="hover:underline font-bold text-white no-underline">대문</a>
            <a href="최근_변경.html" class="hover:underline text-white no-underline">최근 변경</a>
            <a href="최근_토론.html" class="hover:underline text-white no-underline">최근 토론</a>
        </div>
    </div>
    <div class="flex flex-col items-end gap-1">
        <div class="flex items-center gap-2">
            <div class="hidden lg:flex items-center gap-1 mr-2">
