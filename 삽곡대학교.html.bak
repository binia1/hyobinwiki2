<!-- ================= [오류 완전히 수정된 무결점 JS 스크립트] ================= -->
<script>
    function handleSearch() {
        const query = document.getElementById('headerSearchInput').value;
        if (query) {
            window.open(`https://namu.wiki/w/${encodeURIComponent(query)}`, '_blank');
        } else {
            showMsg('검색어를 입력해주세요.');
        }
    }

    function showMsg(text) {
        const box = document.getElementById('wiki-msg-box');
        box.innerText = text; 
        box.style.display = 'block';
        setTimeout(() => { box.style.display = 'none'; }, 2000);
    }

    async function goToLink(filename) {
        if (filename.startsWith('#')) return;
        
        const pureName = filename.replace('.html', '').replace(/_/g, ' ');
        const namuKeywords = ['대한민국', '전문대학', '시부야 카논', '러브 라이브! 슈퍼스타!!'];
        
        // 정상적인 효빈위키 외부 링크로 열기
        if (filename.includes('namu.wiki') || namuKeywords.includes(pureName)) {
            window.open(`https://namu.wiki/w/${encodeURIComponent(pureName)}`, '_blank');
            return;
        }
        
        // 내부 페이지 이동
        try {
            location.href = filename;
        } catch (e) {
            showMsg('문서를 찾을 수 없습니다.');
        }
    }
    
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            const targetId = this.getAttribute('href');
            if (!targetId || targetId === '#') return;
            e.preventDefault();
            const targetElement = document.querySelector(targetId);
            if(targetElement){
                window.scrollTo({ top: targetElement.offsetTop - 80, behavior: 'smooth' });
                targetElement.style.transition = 'background 0.5s';
                targetElement.style.backgroundColor = '#fff3e0'; 
                setTimeout(() => { targetElement.style.backgroundColor = 'transparent'; }, 1500);
            }
        });
    });

    const tooltip = document.getElementById('wiki-fn-tooltip');
    const footnotes = document.querySelectorAll('.wiki-fn');
    
    footnotes.forEach(fn => {
        fn.addEventListener('mouseenter', (e) => {
            const targetId = fn.getAttribute('href').substring(1); 
            const contentEl = document.getElementById(targetId);
            if (contentEl) {
                tooltip.innerHTML = contentEl.innerHTML;
                const backLink = tooltip.querySelector('.wiki-fn-back');
                if(backLink) backLink.style.display = 'none'; 
                tooltip.style.display = 'block';
            }
        });
        fn.addEventListener('mousemove', (e) => {
            const x = e.clientX + 15;
            const y = e.clientY + 15;
            const tooltipRect = tooltip.getBoundingClientRect();
            let finalX = x;
            let finalY = y;
            if (x + tooltipRect.width > window.innerWidth) finalX = e.clientX - tooltipRect.width - 10;
            if (y + tooltipRect.height > window.innerHeight) finalY = e.clientY - tooltipRect.height - 10;
            tooltip.style.left = finalX + 'px';
            tooltip.style.top = finalY + 'px';
        });
        fn.addEventListener('mouseleave', () => {
            tooltip.style.display = 'none';
        });
    });
</script>
<script src="assets/wiki_index.js"></script>
<script src="assets/hb_data_map.js"></script>
<script src="assets/hb_wiki_core.js"></script>
<script src="assets/hb_index_scripts.js"></script>
<script src="assets/jana.js"></script>
