<!DOCTYPE html>

<html lang="ko">
<head>
<link href="이미지/효빈위키아이콘.webp" rel="icon"/>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>서윤수 - 효빈위키</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="css/election_district.css" rel="stylesheet"/>
<style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;700;900&display=swap');
        
        :root { 
            /* [테마 컬러 설정] 더불어민주당 소속이므로 메인 컬러를 파란색으로 변경 */
            --wiki-main: #004EA2; 
            /* 덕빈남도 내비게이션 표 헤더 색상 지정 */
            --wiki-nav-bg: #1D4ED8;
            /* 상단 검색창 내비게이션 바 색상 */
            --top-nav-bg: #7777AA;
            --wiki-border: #ccc; 
            --wiki-bg: #ffffff; 
            --wiki-text: #373a3c; 
            --wiki-gray-bg: #F9F9FA; 
            --wiki-link: #0022AA;
            --wiki-table-header: var(--wiki-main);
            --wiki-table-header-text: #ffffff;
            
            /* 정당 색상 (역사적 색상 완벽 반영) */
            --party-minju: #004EA2;      
            --party-ppp: #E61E2B;        
            --party-hannara: #0033CC;    
            --party-saenuri: #C9151E;    
            --party-bareun: #00B1D2;     
            --party-ncn: #008000;        
            --party-mdp: #FFF000;        
            --party-uri: #FF9933;        
            --party-dup: #FFCC00;
            --party-npad: #00AEEF;       
            --party-indep: #888888;      
        }

        body { font-family: 'Noto Sans KR', sans-serif; background-color: var(--wiki-bg); color: var(--wiki-text); line-height: 1.6; word-break: keep-all; margin: 0; }
        .wiki-container { max-width: 1300px; margin: 0 auto; padding: 20px 40px; border-left: 1px solid var(--wiki-border); border-right: 1px solid var(--wiki-border); min-height: 100vh; background-color: var(--wiki-bg); }

        /* 타이틀 스타일 */
        .txt-lvl-1 { font-size: var(--font-h1) !important; font-weight: 900 !important; color: #000000; line-height: 1.1; letter-spacing: -1.5px; margin-bottom: 0; } 
        .title-area { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid #ccc; margin-bottom: 20px; padding-bottom: 10px; }

        /* 문단 제목 스타일 */
        h2 { font-size: 1.8rem !important; font-weight: 700; border-bottom: 1px solid var(--wiki-border); padding-bottom: 5px; margin-top: 2.5rem; display: flex; align-items: center; gap: 10px; color: var(--wiki-main); clear: both; }
        h2::before { content: ""; display: inline-block; width: 5px; height: 1.8rem; background: var(--wiki-main); }
        h3 { font-size: 1.4rem !important; font-weight: 700; margin-top: 1.8rem; border-left: 4px solid var(--wiki-main); padding-left: 12px; color: var(--wiki-main); }
        h4 { font-size: 1.15rem !important; font-weight: 700; margin-top: 1.2rem; margin-bottom: 0.5rem; color: #444; border-left: 3px solid #ccc; padding-left: 8px; }

        /* 위키 버튼 */
        .wiki-btn { 
            border: 1px solid #ccc; background: white; padding: 4px 12px; border-radius: 4px; font-size: var(--font-small); font-weight: bold; color: #555; 
            cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 4px; text-decoration: none !important; 
        }
        .wiki-btn:hover { background: #f0f0f0; color: #000; border-color: #999; }

        /* 링크 스타일 */
        .wiki-link { color: var(--wiki-link); font-weight: bold; cursor: pointer; text-decoration: none; }
        .wiki-link:hover { text-decoration: underline; }
        .category-box { background: #f9f9f9; border: 1px solid var(--wiki-border); padding: 8px 12px; font-size: 0.8rem; margin: 15px 0; border-radius: 4px; }
        
        /* 인포박스 (프로필용) */
        .infobox { border: 2px solid var(--wiki-main); background-color: #fff; width: 100%; max-width: 450px; font-size: 0.9rem; margin-bottom: 20px; float: right; margin-left: 20px; border-radius: 4px; overflow: hidden; }
        .infobox-title { background-color: var(--wiki-main); color: white; padding: 10px; text-align: center; font-size: 1.3rem !important; font-weight: bold; }
        .infobox table { border: none; width: 100%; border-collapse: collapse; }
        .infobox th { background-color: var(--wiki-main); color: #fff; width: 100px; padding: 6px 8px; border: 1px solid var(--wiki-border); text-align: center; vertical-align: middle; font-weight: bold; }
        .infobox td { padding: 6px 8px; border: 1px solid var(--wiki-border); vertical-align: middle; }

        /* 데이터 테이블 */
        .data-table { border-collapse: collapse !important; width: 100% !important; margin: 15px 0; border: 1px solid var(--wiki-border) !important; font-size: 0.95rem; }
        .data-table th, .data-table td { border: 1px solid var(--wiki-border) !important; padding: 8px 12px; }
        .data-table th { background-color: var(--wiki-table-header); color: var(--wiki-table-header-text); font-weight: bold; text-align: center; }
        .data-table tr:nth-child(even) { background-color: #fdfdfd; }

        /* 목차 */
        .toc { display: inline-block; min-width: 300px; border: 1px solid var(--wiki-border); background: var(--wiki-gray-bg); padding: 15px; border-radius: 4px; margin-bottom: 20px; }
        .toc-title { text-align: center; font-weight: bold; border-bottom: 1px solid var(--wiki-border); margin-bottom: 10px; padding-bottom: 5px; }
        .toc ul { list-style: none; padding: 0; margin: 0; font-size: 0.9rem; }
        .toc ul li { margin-bottom: 4px; }
        .toc ul ul { margin-top: 4px; margin-left: 20px; }
        
        /* [특수 스타일] 효빈위키 느낌 요소 */
        blockquote { border-left: 4px solid var(--wiki-main); padding-left: 15px; margin: 15px 0; color: #555; background-color: #f8f9fa; padding: 10px; font-style: italic; }
        del { color: #ccc; text-decoration: line-through; } 
        .wiki-gray { color: #888; font-size: 0.9em; } 
        
        /* 정당 뱃지 스타일 */
        .party-badge { display: inline-block; padding: 4px 8px; border-radius: 4px; color: white; font-weight: bold; font-size: 0.9em; text-decoration: none; line-height: 1.2; text-shadow: 0 1px 2px rgba(0,0,0,0.1); }
        .party-label { display: inline-block; padding: 2px 6px; border-radius: 3px; font-size: 0.9em; font-weight: bold; text-decoration: none; color: white; }
        .party-minju { background: var(--party-minju); }
        .party-ppp { background: var(--party-ppp); }
        .party-hannara { background: var(--party-hannara); }
        .party-saenuri { background: var(--party-saenuri); }
        .party-bareun { background: var(--party-bareun); }
        .party-ncn { background: var(--party-ncn); }
        .party-mdp { background: var(--party-mdp); color: black !important; text-shadow: none; } 
        .party-uri { background: var(--party-uri); }
        .party-dup { background: var(--party-dup); color: black !important; text-shadow: none; }
        .party-npad { background: var(--party-npad); }
        .party-indep { background: var(--party-indep); }

        /* 각주 스타일 */
        .wiki-fn-link { color: var(--wiki-link); font-size: 0.8em; vertical-align: super; text-decoration: none; font-weight: bold; cursor: pointer; margin-left: 2px; }
        
        /* 각주 툴팁 */
        #wiki-tooltip { display: none; position: absolute; background: white; border: 1px solid #999; padding: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.2); max-width: 350px; z-index: 9999; font-size: 0.85rem; border-radius: 4px; line-height: 1.4; color: #333; pointer-events: none; }

        /* 내비게이션 박스 스타일 */
        .nav-table { width: 100%; border-collapse: collapse; margin: 15px 0 25px 0; border: 2px solid var(--wiki-nav-bg); font-size: 0.9rem; }
        .nav-header { background-color: var(--wiki-nav-bg); color: white; padding: 8px; text-align: center; font-weight: bold; }
        .nav-th { color: white; text-decoration: none; font-weight: bold; display: block; padding: 4px; }
        .nav-link { font-weight: bold; text-decoration: none; }
        .nav-link.minju { color: var(--party-minju); }
        .nav-link.ppp { color: var(--party-ppp); }
        .nav-link.indep { color: var(--party-indep); }
        details > summary { list-style: none; cursor: pointer; }
        details > summary::-webkit-details-marker { display: none; }

        /* 관수 역대 군수 내비게이션 박스 스타일 */
        .history-nav-table-gwansu { width: 100%; border-collapse: collapse; margin: 15px 0 25px 0; border: 1px solid #e49dfd; font-size: 0.9rem; font-family: 'Noto Sans KR', sans-serif;}
        .history-nav-header-gwansu { background-color: #e49dfd; color: #222; padding: 12px; text-align: center; font-weight: bold; }
        .history-nav-header-gwansu img { display: inline-block; vertical-align: middle; margin-right: 8px; height: 24px; }
        .history-nav-toggle-gwansu { background-color: #f3d4fe; color: #333; padding: 6px; text-align: center; font-weight: bold; cursor: pointer; border-bottom: 1px solid #e49dfd; font-size: 0.85rem;}
        .history-nav-content { display: block; }
        .history-nav-table-gwansu td { border: 1px solid #e2e8f0; padding: 10px; text-align: center; width: 20%; vertical-align: top;}
        .history-nav-table-gwansu .th-span { display: block; color: #64748b; font-size: 0.8rem; margin-bottom: 4px; }
        .history-nav-table-gwansu .name-span { display: block; font-weight: 500; color: #333;}
        .history-nav-table-gwansu .current-term { background-color: #faf0ff; }
        .history-nav-table-gwansu .current-term .name-span { color: #b137d6; font-weight: bold; }

        /* 푸터 */
        .wiki-footer { margin-top: 40px; border-top: 1px solid #ccc; padding: 20px; text-align: left; font-size: 0.8rem; color: #555; background-color: #f9f9f9; line-height: 1.5; }
        
        #wiki-msg-box { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,0.8); color: white; padding: 10px 24px; border-radius: 50px; font-size: 14px; z-index: 10000; display: none; }
        .anchor-offset { scroll-margin-top: 70px; }
/* 로고 박스 스타일 추가 */
        .nav-logo-box {
            width: 30px; height: 30px; background: white; color: var(--wiki-main);
            border-radius: 4px; font-weight: 900; display: flex; align-items: center;
            justify-content: center; font-size: 1.2rem;
        }   
 
    
</style>
<script src="ad_logic.js"></script>

    <!-- 효빈위키 폰트 CSS -->
    <link rel="stylesheet" href="wiki_font_standard.css">
</head>        

