<script>
    // 검색 기능 핸들러
    function handleSearch() {
        const query = document.getElementById('searchInput').value;
        if (query) {
            window.open(`https://namu.wiki/w/${encodeURIComponent(query)}`, '_blank');
        } else {
            showMsg('검색어를 입력해주세요.');
        }
    }

    function showMsg(text) {
        const box = document.getElementById('wiki-msg-box');
        box.innerText = text; 
        box.style.display = 'block';
        setTimeout(() => { box.style.display = 'none'; }, 2000);
    }

    async function goToLink(filename) {
        if (!filename || filename.startsWith('#')) return;
        const pureName = filename.replace('.html', '').replace(/_/g, ' ');
        const namuKeywords = ['대한민국', '사립대학', '1992년_개교', '간호학과', '물리치료학과', 'AI소프트웨어학과', '웹툰애니메이션학과', '경찰행정학과', '사회복지학과', '반려동물보건학과', '스마트드론산업과', '뷰티케어학과', '소방방재학과', '치위생과', '응급구조학과'];
        if (namuKeywords.includes(pureName) || filename.includes('namu.wiki')) {
            showMsg(`'${pureName}' 문서는 외부 위키로 연결됩니다.`);
            setTimeout(() => { window.open(`https://namu.wiki/w/${encodeURIComponent(pureName)}`, '_blank'); }, 1000);
            return;
        }
        try {
            const response = await fetch(filename, { method: 'HEAD' });
            if (response.ok) { location.href = filename; } else { throw new Error('Not Found'); }
        } catch (e) {
            showMsg(`'${pureName}' 문서를 찾을 수 없어 외부 위키로 이동합니다.`);
            setTimeout(() => { window.open(`https://namu.wiki/w/${encodeURIComponent(pureName)}`, '_blank'); }, 1200);
        }
    }
    
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            const targetId = this.getAttribute('href');
            if (!targetId || targetId === '#') return;
            e.preventDefault();
            const targetElement = document.querySelector(targetId);
            if(targetElement){
                window.scrollTo({ top: targetElement.offsetTop - 80, behavior: 'smooth' });
                targetElement.style.transition = 'background 0.5s';
                targetElement.style.backgroundColor = '#fff3cd';
                setTimeout(() => { targetElement.style.backgroundColor = 'transparent'; }, 1500);
            }
        });
    });
</script>
<script>
document.addEventListener("DOMContentLoaded", function() {
    document.querySelectorAll('a.nw-link').forEach(function(aTag) {
        if (!aTag.hasAttribute('onclick')) {
            let univName = aTag.innerText.trim();
            if (univName) {
                aTag.setAttribute('onclick', `goToLink('${univName}.html')`);
                aTag.style.cursor = 'pointer'; 
            }
        }
    });
});
</script>
<script src="assets/wiki_index.js"></script>
<script src="assets/hb_wiki_core.js"></script>
<script src="assets/hb_index_scripts.js"></script>
<script src="assets/jana.js"></script>
</body>
</html>