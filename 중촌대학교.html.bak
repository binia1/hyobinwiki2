<!DOCTYPE html>
<html lang="ko">
<head>
    <link href="이미지/효빈위키아이콘.webp" rel="icon"/>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>중촌대학교 - 효빈위키</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;900&display=swap');
        
        :root { 
            /* 중촌대학교 테마 컬러 */
            --wiki-main: #103867; /* 중촌 네이비 */
            --wiki-point: #F47920; /* 중촌 오렌지 */
            
            --wiki-bg: #ffffff; 
            --wiki-text: #373a3c; 
            --wiki-gray-bg: #F9F9FA; 
            --wiki-link: #0022AA;
            --wiki-border: #ccc;
        }

        body { font-family: 'Noto Sans KR', sans-serif; background-color: var(--wiki-bg); color: var(--wiki-text); line-height: 1.6; word-break: keep-all; margin: 0; }
        .wiki-container { max-width: 1300px; margin: 0 auto; padding: 20px 40px; border-left: 1px solid var(--wiki-border); border-right: 1px solid var(--wiki-border); min-height: 100vh; background-color: var(--wiki-bg); }

        /* 타이틀 스타일 */
        .txt-lvl-1 { font-size: var(--font-h1) !important; font-weight: 900 !important; color: #000; line-height: 1.1; letter-spacing: -1.5px; margin-bottom: 0; } 
        .title-area { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 3px solid var(--wiki-main); margin-bottom: 20px; padding-bottom: 10px; }

        /* 헤더 스타일 */
        h2 { font-size: 1.8rem !important; font-weight: 700; border-bottom: 1px solid var(--wiki-border); padding-bottom: 5px; margin-top: 2.5rem; display: flex; align-items: center; gap: 10px; color: #333; clear: both; }
        h2::before { content: ""; display: inline-block; width: 8px; height: 1.8rem; background: var(--wiki-main); }
        h3 { font-size: 1.4rem !important; font-weight: 700; margin-top: 1.5rem; border-left: 5px solid var(--wiki-main); padding-left: 10px; color: #333; }
        h4 { font-size: 1.1rem !important; font-weight: 700; margin-top: 1.2rem; margin-bottom: 0.5rem; color: var(--wiki-point); }

        /* 위키 버튼 */
        .wiki-btn { border: 1px solid #ccc; background: white; padding: 4px 12px; border-radius: 4px; font-size: var(--font-small); font-weight: bold; color: #555; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 4px; text-decoration: none !important; }
        .wiki-btn:hover { background: #f0f0f0; color: #000; border-color: #999; }

        /* 링크 스타일 */
        .wiki-link { color: var(--wiki-link); font-weight: bold; text-decoration: none; cursor: pointer; }
        .wiki-link:hover { text-decoration: underline; }
        .wiki-gray { color: #888; font-size: 0.9em; }
        .category-box { background: #f9f9f9; border: 1px solid var(--wiki-border); padding: 8px 12px; font-size: 0.8rem; margin: 15px 0; border-radius: 4px; }

        /* 인포박스 외부 틀 */
        .infobox { border: 2px solid var(--wiki-main); background-color: #fff; width: 100%; max-width: 400px; font-size: 0.9rem; margin-bottom: 20px; float: right; margin-left: 20px; border-radius: 4px; overflow: hidden; box-shadow: 2px 2px 5px rgba(0,0,0,0.1); }
        .infobox-title { background-color: var(--wiki-main); color: white; padding: 10px; text-align: center; font-size: 1.4rem !important; font-weight: bold; }
        .infobox table { width: 100%; border-collapse: collapse; border: none; }
        .infobox th { background-color: #f5f5f5; color: #333; width: 90px; padding: 8px 10px; border-bottom: 1px solid #ddd; border-right: 1px solid #ddd; text-align: center; font-weight: bold; font-size: 0.85rem; vertical-align: middle; }
        .infobox td { padding: 8px 10px; border-bottom: 1px solid #ddd; font-size: 0.85rem; vertical-align: middle; }

        /* 목차 */
        .toc { display: inline-block; min-width: 300px; border: 1px solid var(--wiki-border); background: var(--wiki-gray-bg); padding: 15px; border-radius: 4px; margin-bottom: 20px; }
        .toc-title { text-align: center; font-weight: bold; border-bottom: 1px solid var(--wiki-border); margin-bottom: 10px; padding-bottom: 5px; }
        .toc ul { list-style: none; padding: 0; margin: 0; font-size: 0.9rem; }
        .toc li { margin-bottom: 4px; }
        .toc ul ul { margin-top: 4px; margin-left: 20px; }

        /* 기타 요소 */
        blockquote { border-left: 4px solid var(--wiki-main); background: #f1f5f9; padding: 10px 15px; margin: 10px 0; color: #555; font-style: italic; }
        del { color: #ccc; text-decoration: line-through; }
        
        /* 테이블 스타일 (본문용) */
        .content-table { border-collapse: collapse; width: 100%; margin: 10px 0; border: 1px solid #ccc; font-size: 0.95rem; }
        .content-table th { background-color: #f0f0f0; border: 1px solid #ccc; padding: 8px; text-align: center; font-weight: bold; color: #333; }
        .content-table td { border: 1px solid #ccc; padding: 8px; vertical-align: middle; background: white; }

        /* 하단 네비게이션 */
        .nav-box { border: 2px solid var(--wiki-main); margin-top: 40px; font-size: 0.85rem; border-radius: 4px; overflow: hidden; }
        .nav-box-header { background-color: var(--wiki-main); color: white; padding: 8px; font-weight: bold; text-align: center; }
        .nav-box-content { padding: 10px; text-align: center; background: white; line-height: 2; }

        /* 푸터 */
        .wiki-footer { margin-top: 40px; border-top: 1px solid #ccc; padding: 20px; text-align: left; font-size: 0.8rem; color: #555; background-color: #f9f9f9; line-height: 1.5; }
        #wiki-msg-box { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,0.8); color: white; padding: 10px 24px; border-radius: 50px; font-size: 14px; z-index: 10000; display: none; }
        .anchor-offset { scroll-margin-top: 70px; }
        .nav-logo-box { width: 30px; height: 30px; background: white; color: var(--wiki-main); border-radius: 4px; font-weight: 900; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }   

        /* 상단 그라데이션 박스 */
        .gradient-box { background-image: linear-gradient(to right, #103867, #1A528E, #1A528E, #103867); color: white; padding: 20px; text-align: center; border-radius: 5px; margin-bottom: 0px; }
        .wiki-table { border-collapse: collapse; width: 100%; margin: 10px 0; border: 1px solid #ccc; }
        .wiki-table th { background-color: var(--wiki-main); color: white; padding: 8px; border: 1px solid #ccc; text-align: center; font-weight: bold; }
        .wiki-table td { padding: 8px; border: 1px solid #ccc; background: white; }
        .wiki-table-center { text-align: center; }
    </style>
    <script src="ad_logic.js"></script>
    <link href="wiki_font_standard.css" rel="stylesheet"/>
</head>
